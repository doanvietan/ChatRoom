<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="980.0" minWidth="850.0" minHeight="550.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatapp.controller.ServerController"
            stylesheets="@styles.css">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="header-bar">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            <Label text="⚡" styleClass="header-icon"/>
            <VBox spacing="2">
                <Label text="Server Management Panel" styleClass="header-title"/>
                <Label text="Hệ thống giám sát mạng, quản trị người dùng &amp; bảo mật nội dung" styleClass="header-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <!-- ================= TABS ================= -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" styleClass="root-pane">
            <tabs>

                <!-- TAB 1: TERMINAL -->
                <Tab text="  💻  Terminal  ">
                    <BorderPane styleClass="root-pane">
                        <top>
                            <HBox spacing="14" alignment="CENTER_LEFT" styleClass="tool-bar">
                                <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
                                <Label text="IP Server:" styleClass="info-label"/>
                                <TextField fx:id="txtServerIp" text="Offline" editable="false" prefWidth="155" styleClass="info-field"/>
                                <Label text="Port:" styleClass="info-label"/>
                                <TextField fx:id="txtServerPort" text="---" editable="false" prefWidth="75" styleClass="info-field"/>
                                <Separator orientation="VERTICAL" prefHeight="28"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label fx:id="lblStatusDot" text="●" styleClass="status-dot-offline"/>
                                    <Label fx:id="lblStatusText" text="Server đang dừng" styleClass="status-text"/>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </top>
                        <center>
                            <VBox styleClass="log-wrapper">
                                <BorderPane.margin><Insets top="12" right="16" bottom="4" left="16"/></BorderPane.margin>
                                <TextArea fx:id="consoleLog" editable="false" styleClass="console-log" VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </center>
                        <bottom>
                            <HBox spacing="14" alignment="CENTER">
                                <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                                <Button fx:id="btnStart" text="▶  Khởi động" onAction="#onStartServer" styleClass="btn-start"/>
                                <Button fx:id="btnStop" text="⏹  Dừng server" onAction="#onStopServer" disable="true" styleClass="btn-stop"/>
                                <Button fx:id="btnClearLog" text="🗑  Xoá log" onAction="#onClearLog" styleClass="btn-clear"/>
                            </HBox>
                        </bottom>
                    </BorderPane>
                </Tab>

                <!-- TAB 2: DANH SÁCH CLIENT -->
                <Tab fx:id="tabClients" text="  👥  Danh sách Client  " onSelectionChanged="#onClientsTabSelected">
                    <BorderPane styleClass="root-pane">
                        <top>
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="tool-bar">
                                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                                <Label fx:id="lblConnectedCount" text="Đang tải..."/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="🔄 Làm mới" onAction="#onRefreshClients" styleClass="btn-reload"/>
                            </HBox>
                        </top>
                        <center>
                            <TableView fx:id="clientTable">
                                <columns>
                                    <TableColumn fx:id="colClientId" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="colUsername" text="Tài khoản" prefWidth="160"/>
                                    <TableColumn fx:id="colEmail" text="Email" prefWidth="240"/>
                                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120"/>
                                    <TableColumn fx:id="colLastSeen" text="Hoạt động lần cuối" prefWidth="200"/>
                                </columns>
                            </TableView>
                        </center>
                    </BorderPane>
                </Tab>

                <!-- TAB 3: QUẢN LÝ TIN NHẮN -->
                <Tab fx:id="tabMessages" text="  💬  Quản lý Tin Nhắn  " onSelectionChanged="#onMessagesTabSelected">
                    <BorderPane styleClass="root-pane">
                        <top>
                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="tool-bar">
                                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                                <Label fx:id="lblMessageCount" text="Trạng thái: "/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Khóa AES:"/>
                                <PasswordField fx:id="txtSecretKey" promptText="Nhập khóa giải mã..." prefWidth="180"/>
                                <Button text="🔓 Giải mã &amp; Làm mới" onAction="#onRefreshMessages" styleClass="btn-reload"/>
                            </HBox>
                        </top>
                        <center>
                            <TableView fx:id="messageTable">
                                <columns>
                                    <TableColumn fx:id="colMsgId" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="colRoom" text="Phòng" prefWidth="70"/>
                                    <TableColumn fx:id="colSender" text="Người gửi" prefWidth="140"/>
                                    <TableColumn fx:id="colContent" text="Nội dung" prefWidth="350"/>
                                    <TableColumn fx:id="colType" text="Loại" prefWidth="80"/>
                                    <TableColumn fx:id="colTime" text="Thời gian gửi" prefWidth="160"/>
                                </columns>
                                <contextMenu>
                                    <ContextMenu>
                                        <items>
                                            <MenuItem text="🗑 Xoá tin nhắn này khỏi CSDL" onAction="#onDeleteSelectedMessage"/>
                                        </items>
                                    </ContextMenu>
                                </contextMenu>
                            </TableView>
                        </center>
                    </BorderPane>
                </Tab>

            </tabs>
        </TabPane>
    </center>
</BorderPane>
